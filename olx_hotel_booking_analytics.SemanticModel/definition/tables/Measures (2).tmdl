table 'Measures (2)'
	lineageTag: 77042a93-c151-42a3-a697-cc36b6602e11

	measure Revenue = SUM(fact_bookings[revenue_realized])
		formatString: 0
		lineageTag: 531201d0-ed37-44ea-a81a-a28303a6a36c

	measure 'Total Booking' = COUNT(fact_bookings[booking_id])
		formatString: 0
		lineageTag: 18f9d785-b553-4fa2-9c3d-b734cc07df28

	measure 'Total  Capacity' = SUM(fact_aggregated_bookings[capacity])
		formatString: 0
		lineageTag: 12076b1f-18ce-4823-922b-8ec7c61cd33f

	measure 'Total Succesful Booking' = SUM(fact_aggregated_bookings[successful_bookings])
		formatString: 0
		lineageTag: fbdd2e5b-c023-4f6c-b7fb-810f3863e868

	measure 'Occupancy %' = DIVIDE([Total Succesful Booking],[Total  Capacity],0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: aac55673-cce7-4dfa-9706-f12900bfdd23

	measure 'no of days' = DATEDIFF(min(dim_date[date]),MAX(dim_date[date]),day)+1
		formatString: 0
		lineageTag: 2a894806-4e6f-4716-a692-20a7e51e5ed7

	measure 'Total Cancelled Booking' = CALCULATE(COUNT(fact_bookings[booking_id]),fact_bookings[booking_status]="Cancelled")
		formatString: 0
		lineageTag: c0e12004-25e4-42ea-9342-6cb5b8373185

	measure 'Cancelled %' = DIVIDE([Total Cancelled Booking],[Total Booking])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f971188a-f7d6-4b0d-9610-3104dbe8202f

	measure 'Total Checkout' = CALCULATE([Total Booking],fact_bookings[booking_status]="Checked Out")
		formatString: 0
		lineageTag: 41814531-51f5-46fe-a7c9-f7afbcce4381

	measure 'Total No show booking' = CALCULATE([Total Booking],fact_bookings[booking_status]="No Show")
		formatString: 0
		lineageTag: 7f412f26-16d2-4d1e-883e-efccc9cbe890

	measure 'No Show rate %' = DIVIDE([Total No show booking],[Total Booking])
		lineageTag: 68688bcc-dedd-42ca-b5e0-286f00f6e04a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Booking % by Platform' = CALCULATE([Total Booking],ALL(fact_bookings[booking_platform]))*100
		formatString: 0
		lineageTag: ba74aefd-fafa-4173-89f5-1e257b84123e

	measure 'Booking % by Room Class' = CALCULATE([Total Booking],ALL(dim_rooms[room_class]))*100
		formatString: 0
		lineageTag: 0c162866-b22a-443b-8c1f-b2ff679377e2

	measure ADR = DIVIDE([Revenue],[Total Booking])
		lineageTag: a1f7ec30-0299-41b0-a1ff-4c45fb7c53ee

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Realisation %' = 1-[Cancelled %]+[No Show rate %]
		lineageTag: d55ff177-549b-4db0-acfd-a28f53dec13c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Revpar = DIVIDE([Revenue],[Total  Capacity])
		lineageTag: cbea208c-6490-49ca-a4ca-faee66e5b4f7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure DBRN = DIVIDE([Total Booking],[no of days])
		lineageTag: 0645b8e9-5545-4592-b330-2167280da01d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure DSRN = DIVIDE([Total  Capacity],[no of days])
		lineageTag: 73338ac4-dde0-4bf7-9fd9-6776d3203c08

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure DURN = DIVIDE([Total Checkout],[no of days])
		lineageTag: 25809ced-f00e-4ac8-a7a2-fae347b35129

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue WoW change %' = ```
			
			var w=IF(HASONEFILTER(dim_date[wn]),SELECTEDVALUE(dim_date[wn]),MAX(dim_date[wn]))
			
			 var cur=CALCULATE([Revenue],dim_date[wn]=w)
			
			 var prev=CALCULATE([Revenue],FILTER(ALL(dim_date),dim_date[wn]=w-1))
			
			 RETURN
			 DIVIDE(cur,prev,0)-1
			
			```
		lineageTag: d333d56e-c9d1-4d91-ab1c-05e2626b81f6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Occupancy WoW change %' =
			
			Var selv = IF(HASONEFILTER(dim_date[wn]),SELECTEDVALUE(dim_date[wn]),MAX(dim_date[wn]))
			var revcw = CALCULATE([Occupancy %],dim_date[wn]= selv)
			var revpw =  CALCULATE([Occupancy %],FILTER(ALL(dim_date),dim_date[wn]= selv-1))
			
			return
			
			
			DIVIDE(revcw,revpw,0)-1
		lineageTag: 1f17771a-ea6a-4a5c-8ce0-a5486dc4a622

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'ADR WoW change %' =
			
			Var selv = IF(HASONEFILTER(dim_date[wn]),SELECTEDVALUE(dim_date[wn]),MAX(dim_date[wn]))
			var revcw = CALCULATE([ADR],dim_date[wn]= selv)
			var revpw =  CALCULATE([ADR],FILTER(ALL(dim_date),dim_date[wn]= selv-1))
			
			return
			
			
			DIVIDE(revcw,revpw,0)-1
		lineageTag: cfabf9fb-8aba-41c1-acf4-0c936373be5d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Realisation WoW change %' =
			
			Var selv = IF(HASONEFILTER(dim_date[wn]),SELECTEDVALUE(dim_date[wn]),MAX(dim_date[wn]))
			var revcw = CALCULATE([Realisation %],dim_date[wn]= selv)
			var revpw =  CALCULATE([Realisation %],FILTER(ALL(dim_date),dim_date[wn]= selv-1))
			
			return
			
			
			DIVIDE(revcw,revpw,0)-1
		lineageTag: 8ffa3a31-ee2f-4c57-a7e0-17b40653eed9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'DSRN WoW change %' =
			
			Var selv = IF(HASONEFILTER(dim_date[wn]),SELECTEDVALUE(dim_date[wn]),MAX(dim_date[wn]))
			var revcw = CALCULATE([DSRN],dim_date[wn]= selv)
			var revpw =  CALCULATE([DSRN],FILTER(ALL(dim_date),dim_date[wn]= selv-1))
			
			return
			
			
			DIVIDE(revcw,revpw,0)-1
		lineageTag: a84ea9df-0635-4219-8a5b-335e1fe5b9fb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Rating' = AVERAGE(fact_bookings[ratings_given])
		lineageTag: fc4c11eb-8a57-40e8-b549-a336523f6506

		annotation PBI_FormatHint = {"isGeneralNumber":true}

